# Copy to .env and adjust before running `docker compose up -d --build`

# REQUIRED: secret used to sign login tokens (JWT). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Administrator login. The account is seeded on startup; changing ADMIN_PASSWORD
# and restarting the backend updates the stored password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
JWT_EXPIRES_HOURS=8

# Host port the dashboard is served on (http://localhost:8080)
FRONTEND_PORT=8080

# Only needed if browsers call the API directly instead of through nginx
CORS_ORIGINS=http://localhost:8080

MONGODB_DB_NAME=insider_threat_db
GUNICORN_WORKERS=2

# ML & risk thresholds
CONTAMINATION_RATE=0.1
RISK_THRESHOLD_HIGH=60.0
RISK_THRESHOLD_CRITICAL=85.0
