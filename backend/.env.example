APP_ENV=development
PORT=5001
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Administrator login (seeded on startup; changing ADMIN_PASSWORD re-hashes the stored password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
JWT_EXPIRES_HOURS=8

# Comma-separated list of allowed browser origins for direct (non-proxied) API access
CORS_ORIGINS=http://localhost:4200

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/insider_threat_db
MONGODB_DB_NAME=insider_threat_db
USE_MOCK_DB=false
# Fall back to in-memory mongomock if MongoDB is unreachable (keep false in production)
ALLOW_MOCK_FALLBACK=true

# ML & Detection Settings
CONTAMINATION_RATE=0.1
RISK_THRESHOLD_HIGH=60.0
RISK_THRESHOLD_CRITICAL=85.0
